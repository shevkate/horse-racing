// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RaceTrack > snapshots > empty state 1`] = `
"<section class="track">
  <header class="track__header">
    <h2 class="track__title" data-testid="track-title"><span class="track__title--muted">Awaiting race</span></h2>
  </header>
  <div class="track__lanes" data-testid="track-lanes">
    <div class="track__empty" data-testid="track-empty">Click Generate to load horses</div>
  </div>
</section>"
`;

