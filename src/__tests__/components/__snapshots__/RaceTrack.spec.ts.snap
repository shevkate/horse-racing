exports[`RaceTrack > snapshots > podium view after round finishes 1`] = `
"<section class="track">
  <header class="track__header">
    <h2 class="track__title" data-testid="track-title"><span>Round 1 — 1200m</span></h2>
  </header>
  <div class="track__lanes" data-testid="track-lanes">
    <!--v-if-->
    <div class="lane" data-testid="lane" data-horse-id="1"><span class="lane__number">1</span>
      <div class="lane__strip"><span class="horse-icon lane__horse lane__horse--podium" style="color: #ff0000; left: var(--lane-pad); transition-duration: 0s;" role="img" aria-label="Thunderbolt"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36.663 36.663" fill="currentColor" aria-hidden="true">
  <!-- Source icon faces left; mirror the group so the horse runs left → right
